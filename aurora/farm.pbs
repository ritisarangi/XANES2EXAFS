#!/bin/bash -l
# Node farm for the Zn scans on Aurora: every node runs several pinned ORCA jobs at a time
# (layout in sites/aurora.sh), pulling scan branches from a shared queue until it is empty or
# the walltime is nearly used. Submitted by aurora/go.sh, which passes WORK REPO QDIR HOURS, the
# software and layout settings, and optionally TAIL_FRAC, MIN_START_MIN, MARGIN_MIN.
#PBS -N zn_farm
set -u
cd "${WORK:?}" || exit 1
export JOB=${PBS_JOBID%%.*}
# ORCA stops MARGIN_MIN before the walltime, leaving time to re-queue this farm's stopped branches
export DEADLINE=$(( $(date +%s) + ${HOURS:?} * 3600 - ${MARGIN_MIN:-25} * 60 ))
source "$REPO/sites/aurora.sh"
NN=$(sort -u "$PBS_NODEFILE" | wc -l)
SLOTS_TOTAL=$(( NN * $(slots_per_node) ))
mkdir -p logs "$QDIR/active"
rm -f "$QDIR/stop_$JOB"
echo "farm $JOB: $NN nodes, $SLOTS_TOTAL slots of $CORES ranks (HT=$HT HBM=$HBM scratch=$SCRATCH), queue $QDIR ($(grep -c . "$QDIR/tasks.txt") tasks, next $(cat "$QDIR/next")), stops ORCA at $(date -d @$DEADLINE '+%F %T')"

# Tail cutoff: once the queue is empty and fewer than TAIL_FRAC of the slots are still busy,
# stop the stragglers (they continue later in a smaller job) instead of holding idle nodes.
TAIL_FRAC=${TAIL_FRAC:-0.25}
(
  while sleep 300; do
    busy=$(ls "$QDIR/active" | grep -c "^${JOB}_")
    left=$(( $(grep -c . "$QDIR/tasks.txt") - $(cat "$QDIR/next") ))
    echo "$(date '+%F %T') busy $busy/$SLOTS_TOTAL, queue $left left"
    if [ $left -le 0 ] && awk -v b=$busy -v t=$SLOTS_TOTAL -v f=$TAIL_FRAC 'BEGIN{exit !(b > 0 && b < f*t)}'; then
      echo "tail cutoff: stopping the last $busy branches"; touch "$QDIR/stop_$JOB"; break
    fi
  done
) &
MON=$!

[ -n "${TEST:-}" ] && ( sleep 90; echo "== core placement of ORCA processes on $(hostname -s) (psr = core)"; ps -eo psr,comm | grep orca_ | sort -n ) > "logs/test_placement_$JOB.txt" &

export FARM_REQUEUE=1      # this script re-queues at the end (older farms let node.sh do it)
mpiexec -n $NN --ppn 1 --cpu-bind none --hostfile "$PBS_NODEFILE" bash "$REPO/aurora/node.sh"
kill $MON 2>/dev/null; wait $MON 2>/dev/null
# Put this pool's stopped branches back at the front of its queue, so the campaign keeps going
# without anyone on a login node (go.sh submit and the autopilot do the same; the lock keeps them
# apart). The pool's atom range follows the queue folder name.
pool=$(basename "$QDIR")
if [ "$pool" = big ]; then export NATOMS_MIN=${BIG_ATOMS:-100} NATOMS_MAX=1000000; else export NATOMS_MIN=0 NATOMS_MAX=${BIG_ATOMS:-100}; fi
(
  flock 8
  echo "$(date '+%F %T') requeue after farm $JOB ($pool)"
  RESUME_PARTIAL=1 python3 "$REPO/scans/restart.py" . | tail -1
  python3 "$REPO/aurora/queue.py" add . scans/jobs_scan_full.txt "queue/$pool"
) 8>>"$WORK/.gosh.lock" >> logs/requeue_$JOB.log 2>&1
echo "farm $JOB done $(date '+%F %T'); queue next $(cat "$QDIR/next") of $(grep -c . "$QDIR/tasks.txt")"
